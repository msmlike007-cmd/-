rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{doc} { allow read: if true; allow write: if false; } // ads config: edit via Firebase console
    // Each user can read/write only their own farm data.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
